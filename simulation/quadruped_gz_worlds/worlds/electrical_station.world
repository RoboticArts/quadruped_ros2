    <gui fullscreen="0">

      <!-- 3D scene -->
      <plugin filename="GzScene3D" name="3D View">
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0.3 0.9 0.9 0 0.5 -2.0</camera_pose>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>

      <!-- Transform Control -->
      <plugin filename="TransformControl" name="Transform control"/>
      
      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
      <!--
      <plugin filename="JointPositionController" name="JointPositionController">
        <model_name>robot/anymal</model_name>
      </plugin>
-->
      <!--
      <plugin filename="EntityTree" name="Entity tree"/>
      -->

    </gui>


    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>39.551549</latitude_deg>   <!-- world origin latitude -->
      <longitude_deg>-0.468086</longitude_deg> <!-- world origin longitude -->
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>              <!-- ENU = 0 -->
    </spherical_coordinates>
    
    <model name="ground_plane">
        <static>true</static>
        <link name="link">
            <collision name="collision">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                </plane>
            </geometry>
            </collision>
            <visual name="visual">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>500 500</size>
                </plane>
            </geometry>
            <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.8 0.8 0.8 1</specular>
            </material>
            </visual>
        </link>
    </model>

    <!-- Local station components (ensure model.config <name> matches) -->
    <include>
      <name>station_base</name>
      <pose>-40.9745 -35.2897 -0.08 0 -0 0</pose>
      <uri>model://station_base</uri>
    </include>

    <include>
      <name>station_buildings</name>
      <pose>4.2882 -14.4447 0 0 -0 0</pose>
      <uri>model://station_buildings</uri>
    </include>

    <include>
      <name>station_house</name>
      <pose>-13.1814 25.1466 6.41029 0 -0 0</pose>
      <uri>model://station_house</uri>
    </include>

    <include>
      <name>station_robothouse</name>
      <pose>-19.946 9.0 -0.08 0 -0 0</pose>
      <uri>model://station_robothouse</uri>
    </include>

    <include>
      <name>station_fence</name>
      <pose>-40.9731 10.5303 0 0 -0 0</pose>
      <uri>model://station_fence</uri>
    </include>

    <!-- Electrical stuff parts -->
    <include>
      <name>station_electrical_stuff_part_1</name>
      <pose>7.31381 -28.5644 0 0 -0 0</pose>
      <uri>model://station_electrical_stuff_part_1</uri>
    </include>
    <include>
      <name>station_electrical_stuff_part_2</name>
      <pose>7.31332 -28.5641 0 0 0 0</pose>
      <uri>model://station_electrical_stuff_part_2</uri>
    </include>
    <include>
      <name>station_electrical_stuff_part_3</name>
      <pose>7.31332 -28.5641 0 0 0 0</pose>
      <uri>model://station_electrical_stuff_part_3</uri>
    </include>
    <include>
      <name>station_electrical_stuff_part_4</name>
      <pose>7.31332 -28.5641 0 0 0 0</pose>
      <uri>model://station_electrical_stuff_part_4</uri>
    </include>
    <include>
      <name>station_electrical_stuff_part_5</name>
      <pose>7.31332 -28.5641 0 0 0 0</pose>
      <uri>model://station_electrical_stuff_part_5</uri>
    </include>
    <include>
      <name>station_electrical_stuff_part_6</name>
      <pose>7.31332 -28.5641 0 0 0 0</pose>
      <uri>model://station_electrical_stuff_part_6</uri>
    </include>
    <include>
      <name>station_electrical_stuff_part_7</name>
      <pose>7.31332 -28.5641 0 0 0 0</pose>
      <uri>model://station_electrical_stuff_part_7</uri>
    </include>

  </world>
</sdf>